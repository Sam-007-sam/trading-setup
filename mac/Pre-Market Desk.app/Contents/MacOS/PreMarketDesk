#!/bin/bash
# Pre-Market Desk launcher: prepares a private Python environment on first run,
# starts the local data server (which refreshes market data immediately) and
# opens the dashboard in an app-style window.
set -u
PORT=8765
URL="http://127.0.0.1:$PORT/"
RES="$(cd "$(dirname "$0")/../Resources/app" && pwd)"
SUPPORT="$HOME/Library/Application Support/Pre-Market Desk"
mkdir -p "$SUPPORT"
exec >>"$SUPPORT/app.log" 2>&1
echo "=== launch $(date) ==="

notify() { osascript -e "display notification \"$1\" with title \"Pre-Market Desk\"" >/dev/null 2>&1 || true; }
fail()   { osascript -e "display alert \"Pre-Market Desk\" message \"$1\" as critical" >/dev/null 2>&1; exit 1; }

open_window() {
  for b in "Google Chrome" "Microsoft Edge" "Brave Browser"; do
    if [ -d "/Applications/$b.app" ] || [ -d "$HOME/Applications/$b.app" ]; then
      open -na "$b" --args --app="$URL" --user-data-dir="$SUPPORT/window" --no-first-run --window-size=1180,860
      return
    fi
  done
  open "$URL"   # falls back to the default browser (Safari)
}

# Already running? Just open another window.
if curl -s -m 1 "${URL}api/status" | grep -q '"premarket"'; then open_window; exit 0; fi

# App files: code and page are refreshed from the bundle each launch; your data is kept.
mkdir -p "$SUPPORT/code" "$SUPPORT/site/data/briefs"
cp -p "$RES/code/"* "$SUPPORT/code/"
cp "$RES/site/index.html" "$SUPPORT/site/index.html"
[ -f "$SUPPORT/site/data/indices.json" ] || cp -R "$RES/site/data/." "$SUPPORT/site/data/"

# Python 3.9+ (Homebrew, python.org, or Apple's Command Line Tools).
PY=""
for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 /Library/Frameworks/Python.framework/Versions/Current/bin/python3 /usr/bin/python3; do
  if [ -x "$c" ] && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then PY="$c"; break; fi
done
[ -n "$PY" ] || fail "Python 3 is needed. If macOS just offered to install the Command Line Developer Tools, click Install, wait for it to finish, then open Pre-Market Desk again. Otherwise install Python from python.org."

# Private environment with the data libraries (first launch only, about a minute).
VENV="$SUPPORT/venv"
if [ ! -x "$VENV/bin/python" ] || [ "$SUPPORT/code/requirements.txt" -nt "$VENV/.installed" ]; then
  notify "First launch: setting up (about a minute)…"
  rm -rf "$VENV"
  "$PY" -m venv "$VENV" \
    && "$VENV/bin/python" -m pip install -q --upgrade pip \
    && "$VENV/bin/python" -m pip install -q -r "$SUPPORT/code/requirements.txt" \
    && touch "$VENV/.installed" \
    || fail "Setup couldn't download its components. Check your internet connection and open the app again."
fi

# Optional Anthropic API key, kept in your macOS Keychain. Asked once.
KEY="$(security find-generic-password -s "Pre-Market Desk" -a anthropic -w 2>/dev/null || true)"
if [ -z "$KEY" ] && [ ! -f "$SUPPORT/.key-asked" ]; then
  touch "$SUPPORT/.key-asked"
  KEY="$(osascript -e 'set r to display dialog "Optional: paste your Anthropic API key to get the written analysis, news and levels in each refresh. You can skip this; market numbers still update without it." default answer "" with hidden answer with title "Pre-Market Desk" buttons {"Skip", "Save key"} default button "Save key"' -e 'if button returned of r is "Save key" then return text returned of r' 2>/dev/null || true)"
  [ -n "$KEY" ] && security add-generic-password -U -s "Pre-Market Desk" -a anthropic -w "$KEY"
fi

# Start the server (it begins a data refresh straight away) and open the window.
ANTHROPIC_API_KEY="$KEY" PMD_DATA="$SUPPORT/site/data" \
  "$VENV/bin/python" "$SUPPORT/code/server.py" --port "$PORT" --site "$SUPPORT/site" &
for i in $(seq 1 40); do
  curl -s -m 1 "${URL}api/status" | grep -q '"premarket"' && break
  sleep 0.25
done
open_window
wait
